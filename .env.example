# Embodied AI Career OS - 环境变量配置模板
#
# 使用方式：复制为 .env 并填入真实值（.env 已在 .gitignore，不会提交）
#   cp .env.example .env
#
# docker compose up 会自动读取同目录下的 .env 文件完成变量插值。
# 所有 ${VAR:-default} 形式的引用，未设置时回退到 default。

# ========== 数据库 ==========
# 默认 SQLite：零配置本地开发，start.sh 一键启动即可跑（推荐）
# 不要在没有 Docker 的机器上填 Postgres 连接串，否则后端会因连不上库而启动失败
DATABASE_URL=sqlite:///./data/app.db

# 仅 docker compose 场景需要下面三个变量（compose 内部会自动拼接 PG 连接串，
# backend 服务的 DATABASE_URL 由 docker-compose.yml 覆盖，无需在此填写）
POSTGRES_USER=career
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=career_os

# ========== 后端服务 ==========
RELOAD=true
CORS_ORIGINS=http://localhost:3000

# ========== 前端 ==========
# 浏览器侧访问后端的地址
NEXT_PUBLIC_API_URL=http://localhost:8000
# 容器内 SSR / API rewrites 代理目标（docker compose 内部通信）
BACKEND_URL=http://backend:8000

# ========== LLM Provider ==========
# 支持：mock / ollama / deepseek / xiaomi / openai_compatible
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ========== LLM Provider：小米 MiMo ==========
# 专属 Base URL（OpenAI 兼容协议，本项目现用这条）：
#   https://token-plan-cn.xiaomimimo.com/v1
# Anthropic 兼容协议端点（当前 LLM 层只实现了 openai 协议客户端，这条暂不可用；
# 若要用需另加一个 anthropic 客户端）：
#   https://token-plan-cn.xiaomimimo.com/anthropic
#
# 启用方式：LLM_PROVIDER 改为 xiaomi，并填好下面两项
XIAOMI_API_KEY=
# 模型代号（填小米控制台给出的实际模型名）
# ⚠️ 留空会回退读 LLM_MODEL；两者都空时后端会明确报错并退回 Mock。
# 配好 key 后可用 GET https://token-plan-cn.xiaomimimo.com/v1/models 列出可用模型。
XIAOMI_MODEL=
# 可选：想覆盖默认 Base URL 时才填
XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# ========== 嵌入模型（论文 RAG 语义检索）==========
# 装 sentence-transformers 后，embedder 工厂会优先用真语义嵌入；缺失时退回 HashEmbedder（无语义）。
# ⚠️ huggingface.co 在部分网络下不可达，需指国内镜像，否则模型拉不下来：
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录（默认在用户目录）
# HF_HOME=D:/work/embodied-ai-career-os/backend/data/hf-cache

# ========== 提醒通道 ==========
# serverchan | pushplus | email | terminal
REMINDER_CHANNEL=terminal
# Server酱 SendKey / PushPlus Token（terminal 模式可留空）
REMINDER_CHANNEL_KEY=
REMINDER_MORNING_TIME=08:30
REMINDER_EVENING_TIME=21:00
REMINDER_INACTIVITY_DAYS=3
REMINDER_TIMEZONE=Asia/Shanghai

# ========== GitHub 同步 ==========
GITHUB_TOKEN=
# 多个仓库用逗号分隔
GITHUB_REPOS=embodied-ai-career-os
GITHUB_POLL_INTERVAL=30

# 每日学习分钟预算（容量预检口径，2026-09-24 裁决：60-120，越界钳制）
DAILY_STUDY_MINUTES=90
